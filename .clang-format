BasedOnStyle: Google
IndentWidth: 4
ColumnLimit: 100
AlignConsecutiveDeclarations: true

# This value must be equal by absolute value to IndentWidth
AccessModifierOffset: -4

# Newline after function declaration
BreakBeforeBraces: Custom
BraceWrapping:
  AfterFunction: true

# Group includes
IncludeBlocks: Regroup
IncludeCategories:
  - Regex:           '^<.*>'
    Priority:        10

  - Regex:           '^"'
    Priority:        20
